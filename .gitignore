```gitignore
# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Tests cache
.tests/
.pytest_cache/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
htmlcov/
coverage/

# Build artifacts
dist/
build/
*.egg-info/

# Dependencies
venv/
.venv/
pipenv/
Pipfile.lock
poetry.lock
__pypackages__/

# Temporary files
*.tmp
*.temp
*.bak

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```
