{
  "base": "main",
  "integration_id": 15368,
  "ruleset_name": "main-required-ci",
  "workflows": {
    "autofix.yml": {
      "jobs": [
        "autofix"
      ],
      "name": "pre-commit-autofix"
    },
    "ci.yml": {
      "jobs": [
        "Hassfest",
        "HACS Validation",
        "Tests (Python 3.14) / Run pytest with coverage"
      ],
      "name": "CI"
    },
    "dependency-review.yml": {
      "jobs": [
        "dependency-review"
      ],
      "name": "Dependency Review"
    },
    "merge-safety-regression.yml": {
      "jobs": [
        "Merge safety regression"
      ],
      "name": "Merge Safety Regression"
    },
    "pre-commit-ci-lite.yml": {
      "jobs": [
        "pre-commit"
      ],
      "name": "Pre-commit Lite"
    },
    "pyrefly.yml": {
      "jobs": [
        "typecheck"
      ],
      "name": "Pyrefly Type Check"
    },
    "python-modernization.yml": {
      "jobs": [
        "Modernization gate (Python 3.14)"
      ],
      "name": "Python Modernization"
    },
    "validate.yml": {
      "jobs": [
        "Requirements source check",
        "Home Assistant hassfest",
        "HACS validation",
        "Ruff lint + format check",
        "Unit / source-only tests"
      ],
      "name": "Validate"
    }
  }
}
